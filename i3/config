### Status Bar:
bar {
    position top
    font pango:IBM Plex Mono Semibold 12
    workspace_min_width 32
    status_command $HOME/.config/i3/status-bar.sh

    # Click tray icons
    tray_output primary

    colors {
        background              #000000
        statusline              #F0F0F0
        separator               #303030
        focused_workspace       #10F060     #000000     #10F060
        active_workspace        #20F0F0     #000000     #20F0F0
        inactive_workspace      #909090     #000000     #909090
        urgent_workspace        #F03020     #000000     #F03020
    }
}
